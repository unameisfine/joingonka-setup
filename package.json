{
  "name": "@joingonka/setup",
  "version": "0.5.0",
  "description": "One-command installer to point 25 agentic AI coding tools (Claude Code, Codex CLI, opencode, OpenClaw, Hermes, Pi, omp, Cursor, Cline, Kilo Code, Goose, Crush, Qwen Code, Kimi Code, Factory Droid, Zed, Aider, Copilot BYOK, JetBrains, Zoo Code, MiMo Code, MiniMax Code, ZCode, Continue, Roo) at JoinGonka Gateway — a cheap, OpenAI- and Anthropic-compatible API for decentralized Gonka AI inference",
  "type": "module",
  "bin": {
    "joingonka-setup": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node scripts/check-clean-tree.mjs && npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.0.0",
    "commander": "^12.0.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0",
    "write-file-atomic": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/write-file-atomic": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "claude-code",
    "codex-cli",
    "openai-codex",
    "opencode",
    "openclaw",
    "hermes-agent",
    "nous-research",
    "pi-coding-agent",
    "oh-my-pi",
    "omp",
    "cursor",
    "cline",
    "kilo-code",
    "goose",
    "crush",
    "qwen-code",
    "kimi-code",
    "factory-droid",
    "zed-editor",
    "aider",
    "copilot-byok",
    "jetbrains",
    "zoo-code",
    "mimo-code",
    "minimax-code",
    "zcode",
    "continue-dev",
    "roo-code",
    "anthropic",
    "anthropic-api",
    "openai-compatible",
    "ai",
    "llm",
    "cheap-ai-api",
    "cheapest-ai-api",
    "ai-coding-agent",
    "decentralized-ai",
    "gonka",
    "gonka-ai",
    "joingonka",
    "cli",
    "installer"
  ],
  "author": "JoinGonka <support@joingonka.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unameisfine/joingonka-setup.git"
  }
}
